# Read-only tokens. Both stay on the proxy and never reach the browser.
# GitLab: personal access token, scope read_api is enough.
GITLAB_TOKEN=

# Jira: Data Center uses the token alone (bearer auth).
# Jira Cloud additionally needs the account mail address (basic auth).
JIRA_TOKEN=
JIRA_EMAIL=

# Outlook: Kalender veroeffentlichen, ICS-Adresse hier eintragen.
# Die Adresse IST das Geheimnis - wer sie hat, liest den Kalender.
CALENDAR_ICS_URL=
